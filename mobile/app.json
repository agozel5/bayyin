{
  "expo": {
    "name": "Bayyin",
    "slug": "bayyin",
    "owner": "bayyin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#14805A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14805A"
    },
    "ios": {
      "bundleIdentifier": "io.github.agozel5.bayyin",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Bayyin utilise la caméra pour lire le code-barres des produits et photographier les listes d'ingrédients.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.agozel5.bayyin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14805A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "agozel5.github.io",
              "pathPrefix": "/bayyin"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Bayyin utilise la caméra pour lire le code-barres des produits et photographier les listes d'ingrédients.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bayyin utilise la caméra pour photographier les listes d'ingrédients.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#14805A",
          "defaultChannel": "recalls"
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "qa_scan": {
              "foregroundImage": "./assets/shortcuts/qa_scan.png",
              "backgroundColor": "#14805A"
            },
            "qa_search": {
              "foregroundImage": "./assets/shortcuts/qa_search.png",
              "backgroundColor": "#3D84DB"
            },
            "qa_history": {
              "foregroundImage": "./assets/shortcuts/qa_history.png",
              "backgroundColor": "#2F6FC0"
            },
            "qa_rankings": {
              "foregroundImage": "./assets/shortcuts/qa_rankings.png",
              "backgroundColor": "#E2A812"
            }
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BayyinHome",
              "label": "Bayyin · Bilan",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Le bilan de la semaine et le bouton Scanner",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "BayyinScan",
              "label": "Bayyin · Scanner",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Scanner un produit en un geste",
              "previewImage": "./assets/widget-preview-scan.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "BayyinQuick",
              "label": "Bayyin · Raccourcis",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "description": "Scanner, ingrédients, recherche, mode courses",
              "previewImage": "./assets/widget-preview-quick.png",
              "updatePeriodMillis": 0
            },
            {
              "name": "BayyinRecent",
              "label": "Bayyin · Derniers produits",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "description": "Le bilan, les derniers produits et des raccourcis",
              "previewImage": "./assets/widget-preview-recent.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "BayyinWidget",
              "displayName": "Bayyin",
              "description": "Le bilan de la semaine, les derniers produits et le scan",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bayyin utilise votre position pour trouver les commerces halal autour de vous et, pendant le Ramadan, calculer les horaires du jour. Elle n'est jamais envoyée à Bayyin ; pour les horaires, une position arrondie reste sur votre téléphone."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/115e79e5-92bf-4f5f-b8d2-f54574fe2798"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "bayyin",
    "extra": {
      "revenuecat": {
        "ios": "",
        "android": "",
        "entitlement": "premium"
      },
      "eas": {
        "projectId": "115e79e5-92bf-4f5f-b8d2-f54574fe2798"
      },
      "contactEmail": "",
      "site": ""
    }
  }
}
